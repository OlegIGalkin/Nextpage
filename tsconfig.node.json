{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "out",
    "declaration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/guest/**/*.ts",
    "src/extractors/**/*.ts",
    "src/injectors/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
